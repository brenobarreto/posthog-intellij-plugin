<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>io.github.brenobarreto.posthog</id>
    <name>PostHog Toolkit (Community)</name>
    <vendor url="https://github.com/brenobarreto/posthog-intellij-plugin">Breno Barreto</vendor>
    <description><![CDATA[
        <p>See your <a href="https://posthog.com">PostHog</a> feature flags right next to the code that uses them.</p>
        <p>Shows each flag's status inline after flag checks in JavaScript, TypeScript, Java and Kotlin, and warns about
        flag keys that don't exist in your PostHog project. Works in every JetBrains IDE, including the free editions.</p>
        <p><i>This is a community project and is not an official PostHog product.</i> It is a port of PostHog's
        <a href="https://github.com/PostHog/posthog-vscode">VS Code extension</a>.</p>
    ]]></description>

    <!-- Platform only: the plugin must work in every JetBrains IDE, so it can't depend on language plugins. -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.PostHogBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="tools" id="io.github.brenobarreto.posthog.settings"
                                 instanceClass="io.github.brenobarreto.posthog.settings.PostHogSettingsConfigurable"
                                 bundle="messages.PostHogBundle" key="settings.displayName"/>
        <postStartupActivity implementation="io.github.brenobarreto.posthog.cache.PostHogStartupActivity"/>
        <editorFactoryListener implementation="io.github.brenobarreto.posthog.editor.PostHogEditorFactoryListener"/>
        <notificationGroup id="PostHog Toolkit" displayType="BALLOON" bundle="messages.PostHogBundle" key="notification.group"/>
    </extensions>

    <actions>
        <group id="io.github.brenobarreto.posthog.Actions" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="io.github.brenobarreto.posthog.SelectProject"
                    class="io.github.brenobarreto.posthog.actions.SelectProjectAction"/>
            <action id="io.github.brenobarreto.posthog.RefreshData"
                    class="io.github.brenobarreto.posthog.actions.RefreshDataAction"/>
        </group>
    </actions>
</idea-plugin>
